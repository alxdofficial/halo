# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/

# Heavy artifacts anywhere — never commit (regenerated from source)
*.npy
*.npz
*.parquet
*.pt
*.mdl
*.ckpt
*.pth
*.tar.gz

# data/: CODE and authored metadata ARE tracked; downloads & converter-generated files are NOT.
# Authored (tracked): convert.py, metadata.json, eval_labels.json.
# Generated (ignored): sessions/, grids/, manifest.json, labels.json (session->activity map),
# events.json (device-session -> shared physical-event map).
#
# recordings.json (session -> continuous capture) is a converter output too, but is deliberately
# NOT ignored alongside its siblings. It defines the enrollment LEAKAGE UNIT: without it a stream's
# execution ids silently fall back to one-per-label-block, which on opportunity overcounts
# independent enrollment examples by 10.2x and turns a k-curve into adjacent-window binding. A
# checkout that has grids restored from elsewhere but no local conversion would inherit that
# silently. `data.scripts.curate.build_recording_maps --check` verifies it against the converters.
data/datasets/*/downloads/
data/datasets/*/download/
data/datasets/*/raw/
data/datasets/*/sessions/
data/datasets/*/processed/
data/datasets/*/grids/
data/datasets/*/manifest.json
data/datasets/*/labels.json
data/datasets/*/events.json
data/datasets/*/debug_*.png
data/**/bundles/
training_output/
test_output/
eval/results/

# baselines/: adapters + citations ARE tracked; cloned upstream repos are NOT.
baselines/*/repo/
auxiliary_repos/

# Secrets — never commit
.env
*.env
cloud/.env
*.key
*.pem
credentials*.json

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
training/tokenizer/outputs/**/*.pt

# Per-run training/eval artifacts (logs, eval jsons); .pt already ignored above.
# Keep one-time analysis deliverables (m0_probe/, m2_gate/, corpus_audit/, objective_health/).
training/tokenizer/outputs/pretrain*/
training/tokenizer/outputs/*/
training/tokenizer/outputs/**/*.log
training/evidence/outputs/telemetry/

# agent worktrees / session scratch
.claude/

# Dataset/baseline reference PDFs: kept locally for code-vs-paper verification, never redistributed
# (copyright). The provenance that MATTERS is versioned: SOURCE.txt / citation.json / VERIFIED.md.
references/**/*.pdf
references/**/webpage.html
